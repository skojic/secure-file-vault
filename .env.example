# Copy to .env.local and adjust. Every key the app reads is listed here with a dummy value.

# PostgreSQL (docker-compose.yml). 5433 avoids clashing with another local PostgreSQL on 5432.
POSTGRES_PORT=5433
DATABASE_URL=postgres://vault:vault-dev-only@127.0.0.1:5433/secure_file_vault
DATABASE_URL_TEST=postgres://vault:vault-dev-only@127.0.0.1:5433/secure_file_vault_test

# Pool and timeouts (rule 28)
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000

# Password hashing: concurrent argon2id hashes (19 MiB each)
ARGON2_MAX_CONCURRENCY=4

# Self-registration: open | closed (decisions/08)
REGISTRATION_MODE=open

# First admin, read only by `npm run db:seed`. No default: the seed refuses to run without them.
SEED_ADMIN_NAME=First Admin
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-to-a-long-passphrase

# Sessions: server-side lifetime in seconds, extended when less than half remains
SESSION_TTL_SECONDS=43200

# Login rate limits per fixed window (decisions/09)
LOGIN_LIMIT_PER_USERNAME=10
LOGIN_LIMIT_PER_IP=50
LOGIN_WINDOW_SECONDS=300
# Set to true only behind a proxy that sets X-Forwarded-For; otherwise the per-IP limit is skipped
TRUST_PROXY_HEADERS=false
